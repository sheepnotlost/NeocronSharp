# research copies: the game install (GBs) and third-party source trees stay local; notes are kept
Research/*
!Research/*.md

# pictures kept on this PC only (game artwork; the repository is public)
assets/local/

# Recycling item pictures from Tech Haven (game artwork; the repository is public)
item-images/

# local research and other projects, never uploaded
Do Not Commit/

# Traversal engine (C#): build output, generated plans, terrain caches and run logs stay local;
# only the small learned seeds in traversal/logs are committed
traversal/bin/
traversal/obj/
traversal/tests/bin/
traversal/tests/obj/
traversal/out/
traversal/logs/*
!traversal/logs/traversal-crossings.txt
!traversal/logs/traversal-obstacles.txt
!traversal/logs/traversal-blocked.txt
!traversal/logs/traversal-arrows.txt
!traversal/logs/door-graph.txt
